# Copy to .env.local for local development. .env.local is git-ignored.

# The waitlist (lib/waitlist.ts). Without RESEND_API_KEY, development runs dry: nothing is sent, and the confirm link
# shows on the page and in the dev server's log. Production refuses signups until it is set.
RESEND_API_KEY=

# Optional. Defaults: the "Kernel waitlist" segment, Kernel <kernel@cjjutba.dev>, and a secret derived from the API key.
# RESEND_WAITLIST_SEGMENT_ID=
# WAITLIST_FROM=
# WAITLIST_SECRET=

# The site's public origin, for links in emails and metadata. Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://kernel.cjjutba.dev
