{
  "name": "kernel",
  "productName": "Kernel",
  "version": "0.7.0",
  "description": "A Mac app that keeps your AI coding agents organized: say what you need, and Kernel plans it, hands it out and brings it back for your approval.",
  "license": "Elastic-2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p demo/tsconfig.json",
    "test": "node scripts/test.ts",
    "test:changed": "node scripts/test.ts --changed origin/main",
    "shots": "node scripts/shots.ts",
    "scroll-check": "node scripts/scrollCheck.ts",
    "demo:refresh": "node scripts/demo-refresh.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:clips": "vite build --config demo/vite.scenes.config.ts && node demo/clips.ts",
    "postinstall": "electron-builder install-app-deps && node scripts/sqlite-node.ts && install-electron",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "release": "bash scripts/release.sh",
    "update:e2e": "bash scripts/update-e2e.sh",
    "release:notes": "node scripts/release-notes.ts",
    "release:rollout": "node scripts/release-rollout.ts",
    "site:deploy": "bash scripts/deploy-site.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.162.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "happy-dom": "^21.0.1",
    "material-icon-theme": "5.39.0",
    "playwright-core": "^1.64.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
